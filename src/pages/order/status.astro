---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { paymock, type InvoiceStatusResponse } from '../../lib/paymock';
import { ordersStore, type OrderRecord } from '../../lib/orders';

export const prerender = false;

const invoiceIdParam = Astro.url.searchParams.get('invoiceId') || '';
const orderIdParam = Astro.url.searchParams.get('orderId') || '';

let order: OrderRecord | undefined;
let invoiceStatus: InvoiceStatusResponse | null = null;
let errorMsg = '';

if (orderIdParam) {
  order = ordersStore.getById(orderIdParam);
}

const targetInvoiceId = invoiceIdParam || order?.invoiceId;

if (targetInvoiceId) {
  try {
    invoiceStatus = await paymock.getInvoiceStatus(targetInvoiceId);
    if (invoiceStatus.status) {
      ordersStore.updateStatus(targetInvoiceId, invoiceStatus.status, invoiceStatus.paymentInfo);
      if (!order) {
        order = ordersStore.getByInvoiceId(targetInvoiceId);
      }
    }
  } catch (err: any) {
    console.error('[Status Page Error]', err);
    errorMsg = err.message || 'Не вдалося перевірити статус інвойсу';
  }
}

const status = invoiceStatus?.status || order?.status || 'created';
const isSuccess = status === 'success';
const isProcessing = status === 'processing' || status === 'hold' || status === 'created';
const isFailed = status === 'failure' || status === 'reversed';
const isExpired = status === 'expired';

const displayAmount = invoiceStatus?.finalAmount 
  ? invoiceStatus.finalAmount / 100 
  : invoiceStatus?.amount 
    ? invoiceStatus.amount / 100 
    : order 
      ? order.totalAmount / 100 
      : 0;

const paymentInfo = invoiceStatus?.paymentInfo || order?.paymentInfo;
---

<Layout
  title={`Статус замовлення — ${order?.id || targetInvoiceId || 'Kava & Go'}`}
  description="Результат оплати та статус вашого замовлення кави в Kava & Go."
>
  <div class="min-h-screen bg-[#F7F2EB] flex flex-col justify-between">
    <Header brandName="Kava & Go" />

    <main class="w-full max-w-2xl mx-auto px-4 py-8 sm:py-14 flex-1 flex flex-col justify-center">
      <!-- Status Box Card -->
      <div class="bg-[#FAF6F0] rounded-3xl p-6 sm:p-10 shadow-xl border border-[#8A4B29]/20 relative overflow-hidden">
        
        {isSuccess && (
          <div class="text-center mb-6">
            <h1 class="text-2xl sm:text-4xl font-normal" style="color: #2B1810; font-family: 'Rammetto One', cursive, sans-serif; margin: 0;">
              ДЯКУЄМО ЗА ЗАМОВЛЕННЯ!
            </h1>
          </div>
        )}

        {isProcessing && (
          <div class="text-center mb-6">
            <h1 class="text-2xl sm:text-3xl font-normal" style="color: #2B1810; font-family: 'Rammetto One', cursive, sans-serif; margin: 0 0 8px 0;">
              ОБРОБКА ПЛАТЕЖУ...
            </h1>
            <p class="text-sm sm:text-base max-w-md mx-auto" style="color: #6E5849; font-family: 'Fuzzy Bubbles', cursive, sans-serif; margin: 0;">
              Рахунок створено. Сторінка оновиться автоматично після підтвердження.
            </p>
          </div>
        )}

        {isFailed && (
          <div class="text-center mb-6">
            <h1 class="text-2xl sm:text-3xl font-normal" style="color: #8A4B29; font-family: 'Rammetto One', cursive, sans-serif; margin: 0 0 8px 0;">
              ОПЛАТА НЕ ВДАЛАСЯ
            </h1>
            <p class="text-sm sm:text-base max-w-md mx-auto" style="color: #6E5849; font-family: 'Fuzzy Bubbles', cursive, sans-serif; margin: 0;">
              Транзакцію було скасовано або відхилено. Ви можете повторити спробу.
            </p>
          </div>
        )}

        {isExpired && (
          <div class="text-center mb-6">
            <h1 class="text-2xl sm:text-3xl font-normal" style="color: #8A4B29; font-family: 'Rammetto One', cursive, sans-serif; margin: 0 0 8px 0;">
              РАХУНОК ПРОТЕРМІНОВАНО
            </h1>
            <p class="text-sm sm:text-base max-w-md mx-auto" style="color: #6E5849; font-family: 'Fuzzy Bubbles', cursive, sans-serif; margin: 0;">
              15 хвилин дії рахунку вичерпано. Будь ласка, створіть нове замовлення.
            </p>
          </div>
        )}

        {!targetInvoiceId && (
          <div class="text-center mb-8">
            <h1 class="text-2xl text-[#2B1810] font-normal mb-2" style="font-family: 'Rammetto One', cursive, sans-serif;">
              ЗАМОВЛЕННЯ НЕ ЗНАЙДЕНО
            </h1>
            <p class="text-[#6E5849] text-sm">
              Перевірте правильність посилання або оформіть нове замовлення.
            </p>
          </div>
        )}

        <!-- Receipt Summary -->
        {targetInvoiceId && (
          <div class="bg-[#EDE3D5] rounded-2xl p-5 sm:p-6 border border-[#8A4B29]/20 space-y-3.5 mb-8">
            <div class="flex items-center justify-between pb-3 border-b border-[#8A4B29]/15">
              <span class="text-xs uppercase font-bold text-[#6E5849]" style="font-family: 'Fuzzy Bubbles', cursive, sans-serif;">Сума замовлення</span>
              <span class="text-2xl font-bold text-[#8A4B29]" style="font-family: 'Rammetto One', cursive, sans-serif;">
                {displayAmount} ₴
              </span>
            </div>

            {order?.id && (
              <div class="flex items-center justify-between text-sm">
                <span class="text-[#6E5849]">Номер замовлення:</span>
                <span class="font-bold text-[#2B1810]">{order.id}</span>
              </div>
            )}

            <div class="flex items-center justify-between text-sm">
              <span class="text-[#6E5849]">ID інвойсу PayMock:</span>
              <span class="font-mono text-xs bg-white/70 px-2 py-0.5 rounded text-[#2B1810] border border-[#8A4B29]/15">{targetInvoiceId}</span>
            </div>

            {order?.productName && (
              <div class="flex items-center justify-between text-sm">
                <span class="text-[#6E5849]">Товар:</span>
                <span class="font-medium text-[#2B1810] text-right">{order.productName} ({order.quantity} шт.)</span>
              </div>
            )}

            {order?.comment && (
              <div class="flex items-center justify-between text-sm">
                <span class="text-[#6E5849]">Помел / Примітка:</span>
                <span class="font-medium text-[#2B1810] text-right">{order.comment}</span>
              </div>
            )}

            {order?.customerName && (
              <div class="flex items-center justify-between text-sm">
                <span class="text-[#6E5849]">Покупець:</span>
                <span class="font-medium text-[#2B1810]">{order.customerName} {order.customerPhone ? `(${order.customerPhone})` : ''}</span>
              </div>
            )}

            {paymentInfo?.maskedPan && (
              <div class="flex items-center justify-between text-sm pt-2 border-t border-[#8A4B29]/15">
                <span class="text-[#6E5849]">Картка платника:</span>
                <span class="font-mono font-bold text-[#2B1810]">{paymentInfo.maskedPan} ({paymentInfo.paymentSystem || 'Bank Card'})</span>
              </div>
            )}

            {paymentInfo?.approvalCode && (
              <div class="flex items-center justify-between text-xs text-[#6E5849]">
                <span>Код авторизації:</span>
                <span class="font-mono">{paymentInfo.approvalCode}</span>
              </div>
            )}

            {invoiceStatus?.modifiedDate && (
              <div class="flex items-center justify-between text-xs text-[#6E5849]">
                <span>Час транзакції:</span>
                <span>{new Date(invoiceStatus.modifiedDate).toLocaleString('uk-UA')}</span>
              </div>
            )}
          </div>
        )}

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          {isProcessing && order?.pageUrl && (
            <a
              href={order.pageUrl}
              class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-[#8A4B29] text-white font-bold text-center uppercase tracking-wider text-sm shadow-md hover:bg-[#6f3b20] transition-colors no-underline"
              style="font-family: 'Rammetto One', cursive, sans-serif;"
            >
              Перейти до оплати PayMock
            </a>
          )}

          <a
            href="/"
            class="w-full sm:w-auto px-7 py-3.5 rounded-2xl font-bold text-center uppercase tracking-wider text-sm transition-all hover:scale-105 active:scale-95 no-underline shadow-md"
            style="font-family: 'Rammetto One', cursive, sans-serif; background-color: #8A4B29; color: #FFFFFF; border: none;"
          >
            ← На головну сторінку
          </a>

          {isProcessing && (
            <button
              id="refresh-status-btn"
              class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-white border border-[#8A4B29]/25 text-[#8A4B29] hover:bg-[#8A4B29]/10 font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-2 cursor-pointer transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                <path d="M3 3v5h5"></path>
                <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path>
                <path d="M16 21h5v-5"></path>
              </svg>
              Оновити статус
            </button>
          )}
        </div>

        {errorMsg && (
          <div class="mt-4 p-3 bg-red-50 text-red-700 text-xs rounded-xl border border-red-200 text-center">
            {errorMsg}
          </div>
        )}
      </div>
    </main>

    <Footer brandName="Kava & Go" />
  </div>
</Layout>

<script define:vars={{ targetInvoiceId, isProcessing }}>
  const refreshBtn = document.getElementById('refresh-status-btn');
  if (refreshBtn) {
    refreshBtn.addEventListener('click', () => {
      window.location.reload();
    });
  }

  // Auto-polling if currently in processing / waiting state
  if (isProcessing && targetInvoiceId) {
    const pollInterval = setInterval(async () => {
      try {
        const res = await fetch(`/api/status?invoiceId=${encodeURIComponent(targetInvoiceId)}`);
        if (res.ok) {
          const data = await res.json();
          if (data?.invoice?.status && data.invoice.status !== 'created' && data.invoice.status !== 'processing') {
            clearInterval(pollInterval);
            window.location.reload();
          }
        }
      } catch (e) {
        // ignore polling network errors
      }
    }, 3000);

    // Stop polling after 5 minutes
    setTimeout(() => clearInterval(pollInterval), 300000);
  }
</script>
