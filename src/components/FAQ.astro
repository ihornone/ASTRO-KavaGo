---
import { FAQS, type FAQItem } from '../lib/faqs';

const faqs: FAQItem[] = FAQS;
---

<section id="faq" class="w-full bg-[#F7F2EB] py-12 sm:py-16 md:py-24 px-4 sm:px-8 lg:px-12 flex flex-col items-center overflow-hidden">
  <div class="w-full max-w-[1100px] flex flex-col items-center gap-6 sm:gap-8 md:gap-12">
    <!-- FAQ Heading -->
    <h2
      class="uppercase text-center select-none"
      style="color: #D9C3B0; font-family: 'Rammetto One', cursive, sans-serif; font-size: clamp(50px, 14vw, 226px); font-style: normal; font-weight: 400; line-height: 1;"
    >
      FAQ
    </h2>

    <!-- FAQ Accordion List -->
    <div class="w-full flex flex-col gap-3 sm:gap-4 md:gap-5">
      {faqs.map((faq, index) => (
        <div
          class="faq-card w-full bg-[#EFE6DC] rounded-xl sm:rounded-2xl shadow-xs transition-shadow duration-200 hover:shadow-md border border-[#8A4B29]/15 overflow-hidden flex flex-col px-5 py-5 sm:px-8 sm:py-7 md:px-10 md:py-8"
          data-faq-index={index}
        >
          <button
            type="button"
            class="faq-toggle w-full flex items-center justify-between gap-3 sm:gap-4 select-none text-left bg-transparent border-none p-0 cursor-pointer focus-visible:outline-2 focus-visible:outline-[#8A4B29]"
            aria-expanded="false"
          >
            <h3
              class="text-left"
              style="color: #2B1810; font-family: 'Rammetto One', cursive, sans-serif; font-size: clamp(16px, 3.8vw, 32px); font-style: normal; font-weight: 400; line-height: 1.3;"
            >
              {faq.question}
            </h3>
            <div class="faq-icon transform transition-transform duration-220 text-[#8A4B29] shrink-0" style="transition-timing-function: var(--ease-out);">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 sm:w-7 sm:h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </div>
          </button>
          <div class="faq-accordion grid grid-rows-[0fr] transition-[grid-template-rows] duration-250" style="transition-timing-function: var(--ease-out);">
            <div class="overflow-hidden">
              <div class="pt-3 sm:pt-4 text-[#4A2E1E] text-sm sm:text-base md:text-lg leading-relaxed border-t border-[#8A4B29]/15 mt-3 sm:mt-4 opacity-0 transition-opacity duration-200 faq-content select-text" style="font-family: 'Fuzzy Bubbles', cursive, sans-serif; transition-timing-function: var(--ease-out);">
                <p>{faq.answer}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Accessible smooth CSS Grid accordion logic
  document.querySelectorAll('.faq-card').forEach((card) => {
    const toggleBtn = card.querySelector('.faq-toggle');
    const accordion = card.querySelector('.faq-accordion');
    const content = card.querySelector('.faq-content');
    const icon = card.querySelector('.faq-icon');
    if (!toggleBtn || !accordion || !icon || !content) return;

    toggleBtn.addEventListener('click', () => {
      const isOpen = accordion.classList.contains('grid-rows-[1fr]');
      if (isOpen) {
        accordion.classList.remove('grid-rows-[1fr]');
        accordion.classList.add('grid-rows-[0fr]');
        content.classList.remove('opacity-100');
        content.classList.add('opacity-0');
        icon.classList.remove('rotate-180');
        toggleBtn.setAttribute('aria-expanded', 'false');
      } else {
        accordion.classList.remove('grid-rows-[0fr]');
        accordion.classList.add('grid-rows-[1fr]');
        content.classList.remove('opacity-0');
        content.classList.add('opacity-100');
        icon.classList.add('rotate-180');
        toggleBtn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
