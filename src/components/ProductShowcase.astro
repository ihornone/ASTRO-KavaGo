---
interface Product {
  id: string;
  name: string;
  tagline: string;
  image: string;
  colorTheme: string;
  accentColor: string;
  badgeBg: string;
  badgeBorder: string;
  roast: string;
  composition: string;
  feature: string;
  weight: string;
  orderReversed?: boolean;
}

const products: Product[] = [
  {
    id: "kava-and-go-classic",
    name: "KAVA & GO CLASSIC",
    tagline: "GOOD COFFEE, BETTER DAYS • 100% АРАБІКА • ЗНИЖКА 15%",
    image: "/images/1st-image.png",
    colorTheme: "#2C1810",
    accentColor: "#8A4B29",
    badgeBg: "#F7F2EB",
    badgeBorder: "#8A4B29",
    roast: "Medium",
    composition: "100%",
    feature: "Без домішок",
    weight: "250 г",
    orderReversed: false,
  },
  {
    id: "kava-and-go-hazelnut",
    name: "KAVA & GO HAZELNUT",
    tagline: "MORE FLAVOR, MORE MOMENTS • НАТУРАЛЬНИЙ ФУНДУК • ЗНИЖКА 15%",
    image: "/images/2nd-image.png",
    colorTheme: "#33412E",
    accentColor: "#4B6144",
    badgeBg: "#F7F2EB",
    badgeBorder: "#4B6144",
    roast: "Medium",
    composition: "Фундук",
    feature: "Без барвників",
    weight: "250 г",
    orderReversed: true,
  },
];
---

<section id="products" class="w-full bg-[#F7F2EB] overflow-hidden">
  <div class="w-full grid grid-cols-1 md:grid-cols-2 overflow-hidden">
    <!-- Product 1: Kava & Go Classic -->
    <!-- Image Card -->
    <div class="bg-[#2C1810] min-h-[380px] sm:min-h-[480px] lg:min-h-[640px] flex items-center justify-center p-6 sm:p-8 lg:p-12 overflow-hidden relative group cursor-pointer">
