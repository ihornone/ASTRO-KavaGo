        alt="Кава в зернах Kava & Go Classic 100% Arabica"
        class="max-h-[360px] sm:max-h-[460px] lg:max-h-[580px] w-auto object-contain drop-shadow-2xl group-hover:scale-105 transition-transform duration-500"
        src="/images/1st-image.png"
      />
      <!-- Hover Overlay on Desktop -->
      <div class="absolute inset-0 hidden md:flex items-center justify-center pointer-events-none bg-black/30 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        <button
          data-buy-product="kava-and-go-classic"
          class="pointer-events-auto px-8 py-4 rounded-full shadow-2xl flex items-center gap-2.5 transition-all duration-300 font-normal uppercase tracking-wider transform scale-90 group-hover:scale-100 hover:scale-105 active:scale-95 cursor-pointer relative overflow-visible"
