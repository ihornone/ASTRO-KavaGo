---
interface Props {
  title?: string;
  description?: string;
  videoSrc?: string;
}

const {
  title = "ПРО KAVA & GO",
  description = "МИ ПОЧАЛИ З ПРОСТОЇ ІДЕЇ: КАВА З СОБОЮ МАЄ БУТИ НЕ ПРОСТО ШВИДКОЮ, А БЕЗДОГАННОЮ. СВІЖЕ ОБСМАЖУВАННЯ, КРАФТОВИЙ ПІДХІД, ПРОФЕСІЙНІ БАРИСТА ТА ТЕПЛО В КОЖНОМУ ГОРНЯТКУ.",
  videoSrc = "/videos/about-us-video.mp4",
} = Astro.props;
---

<section id="about" class="w-full bg-[#EAE0D3] pt-12 sm:pt-[70px] pb-12 sm:pb-[70px] px-5 sm:px-8 md:px-12 lg:px-16 overflow-hidden">
  <div class="max-w-[1440px] mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-start">
    <!-- Left Column: Story & Action -->
    <div class="flex flex-col h-full justify-between">
      <div>
        <h2
          class="uppercase"
          style="color: #8A4B29; font-family: 'Rammetto One', cursive, sans-serif; font-size: clamp(34px, 5.5vw, 76px); font-style: normal; font-weight: 400; line-height: 1;"
        >
          {title}
        </h2>

        <!-- Responsive spacer -->
        <div class="h-4 sm:h-8 md:h-[80px] lg:h-[240px]"></div>

        <a
          href="#products"
          class="w-fit cursor-pointer hover:opacity-90 active:scale-95 transition-all shadow-md no-underline inline-flex items-center gap-2"
          style="padding: 14px 22px; border-radius: 12px; background: #8A4B29; border: none;"
        >
          <span style="color: #FFFFFF; text-align: center; font-family: 'Fuzzy Bubbles', cursive, sans-serif; font-size: 16px; font-style: normal; font-weight: 700; line-height: 18px; text-transform: uppercase;">
            ДЕ СКУШТУВАТИ
          </span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-white">
            <line x1="7" y1="17" x2="17" y2="7"></line>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </a>

        <p
          class="mt-4 sm:mt-6 max-w-[580px]"
          style="align-self: stretch; color: #4A2E1E; font-family: 'Fuzzy Bubbles', cursive, sans-serif; font-size: clamp(14px, 3.5vw, 17px); font-style: normal; font-weight: 700; line-height: 1.5; text-transform: uppercase;"
        >
          {description}
        </p>
      </div>
    </div>

    <!-- Right Column: Video Container -->
    <div class="w-full h-full min-h-[260px] sm:min-h-[400px] lg:min-h-[600px] flex items-center justify-center">
      <div class="w-full h-full rounded-[24px] overflow-hidden shadow-lg border border-[#8A4B29]/15">
        <video
          autoplay
          loop
          playsinline
          muted
          class="w-full h-full object-cover rounded-[24px]"
        >
          <source src={videoSrc} type="video/mp4" />
          Your browser does not support the video tag.
        </video>
      </div>
    </div>
  </div>
</section>
