---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Кава в зернах та дріп-пакети — Kava & Go | Свіже обсмажування",
  description = "100% спешелті-арабіка Q 84+ свіжого обсмажування. Зерно на вибір помелу, дріп-пакети та кава з собою. Доставка Новою Поштою 1-2 дні, знижка 15% на перше замовлення."
} = Astro.props;
---

<!doctype html>
<html lang="uk" data-scroll-behavior="smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kava & Go" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/header-images.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/images/header-images.png" />

    <!-- Preload Fonts -->
    <link rel="preload" href="/fonts/83afe278b6a6bb3c-sp0q-301v4kxxnr.woff2" as="font" type="font/woff2" crossorigin />
    
    <!-- Google Fonts: Rammetto One (Display/Headings), Fuzzy Bubbles (Vintage Accents), Bubblegum Sans (Logo), Inter (Body UI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bubblegum+Sans&family=Fuzzy+Bubbles:wght@400;700&family=Rammetto+One&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Original Compiled CSS for baseline utilities -->
    <link rel="stylesheet" href="/css/0nn4nde3f76s.css" />
    <link rel="stylesheet" href="/css/0rn43j5dzccd.css" />
  </head>
  <body class="bg-[#F7F2EB] text-[#1E140F] selection:bg-[#8A4B29] selection:text-white">
    <slot />

    <!-- Interactive Logic Script -->
    <script src="/js/main.js" defer></script>
  </body>
</html>
